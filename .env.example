# BinaryBox Games Environment Configuration Example
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local to version control.

# Target Canonical Site URL (Used for SEO, sitemap.xml, robots.txt, and metadata)
NEXT_PUBLIC_SITE_URL=https://binaryboxgames.shivanshji.in

# Game Provider Selection: 'mock' (default) or 'gamemonetize'
GAME_PROVIDER=mock

# GameMonetize Official Publisher Integration Configuration
# Obtain your publisher feed parameters from your GameMonetize dashboard
GAMEMONETIZE_API_URL=https://api.gamemonetize.com/rss.php
GAMEMONETIZE_API_KEY=
GAMEMONETIZE_SITE_ID=
GAMEMONETIZE_FEED_AMOUNT=100

# Optional MongoDB Atlas Persistent Storage (Reserved for future user accounts, favorites, ratings)
MONGODB_URI=

# Optional Google Analytics ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Optional Google Search Console verification token
NEXT_PUBLIC_GSC_VERIFICATION=
